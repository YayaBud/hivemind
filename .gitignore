# Whitelist: only the product code, tests, docs and build scripts are published.
# Local records, benchmark data (contains real chat text), recordings and renders stay out.
/*
!/.gitignore
!/README.md
!/requirements.txt

!/hivemind/
!/web/
!/tests/
!/scripts/
/scripts/enable_local_wsl.ps1

!/docs/
/docs/*
!/docs/assets/
!/docs/superpowers/
!/docs/track02-results/
/docs/track02-results/*
!/docs/track02-results/blog.md
!/docs/deck/
/docs/deck/*
!/docs/deck/deck.html
!/docs/deck/Hivemind-HandsomeSquidward.pdf
!/docs/deck/shots/
/docs/deck/shots/*
!/docs/deck/shots/v3-*.png

!/artifacts/
/artifacts/*
!/artifacts/context-graph-hard/
/artifacts/context-graph-hard/*
!/artifacts/context-graph-hard/REPORT.md

!/deck/
/deck/*
!/deck/build-v3.js
!/deck/package.json
!/deck/package-lock.json

!/video/
/video/*
!/video/src/
!/video/record.mjs
!/video/music.py
!/video/package.json
!/video/package-lock.json

__pycache__/
*.pyc
node_modules/
.env
